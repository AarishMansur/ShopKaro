# Copy to .env and adjust. Every value has a safe default — `docker compose up`
# works with no .env at all (seeded demo shop, no AI profiles).

# Ports published on the host
WEB_PORT=3000
API_PORT=8080
DB_PORT=15432

# Shop identity (shown in the sidebar and weekly report)
SHOP_NAME=Sharma Kirana Store
SHOP_TZ=Asia/Kolkata
SUMMARY_LANG=en

# --- profile: ai (docker compose --profile ai up) ---------------------------
# Default points at the compose service; pings Ollama so it degrades safely.
OLLAMA_URL=http://ollama:11434
GEMMA_MODEL=gemma3:4b
# Vision model used for "fill details from photo" (defaults to GEMMA_MODEL).
GEMMA_VISION_MODEL=
# Set when running the whisper sidecar so phone recording uses Whisper;
# leave empty to fall back to the browser speech API.
# WHISPER_URL=http://whisper:9000

# --- TabPFN reorder forecast (Partner prize track) --------------------------
# Get a key at https://api.priorlabs.ai — without it the forecast uses the
# built-in seasonal-trend fallback.
TABPFN_BASE_URL=https://api.priorlabs.ai
TABPFN_API_KEY=

# --- profile: temporal (TEMPORAL_ENABLED=true docker compose --profile temporal up)
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
